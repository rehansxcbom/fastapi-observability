                        "rawQuery": true,
                        "rawSql": "SELECT\n  path,\n  COUNT(*) as total_calls,\n  ROUND(AVG(request_duration_ms)::numeric, 2) AS avg_duration_ms,\n  MAX(request_duration_ms) AS max_duration_ms,\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY request_duration_ms) AS p95_duration_ms\nFROM request_metrics \nWHERE $__timeFilter(request_time)\nGROUP BY path\nORDER BY p95_duration_ms DESC",
